{
  "name": "react-timespace",
  "version": "0.2.1",
  "description": "Multi-timezone timeline React component — drag time intervals across timezone rows with collision-resolved clock labels. Extracted from SyncContact.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./theme-config": "./dist/theme-config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "lucide-react": "1.14.0",
    "prop-types": "15.8.1",
    "react-colorful": "5.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.1.5",
    "vitest": "4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/it-pal-net/react-timespace.git"
  },
  "homepage": "https://synccontact.com/timespace",
  "keywords": [
    "react",
    "timezone",
    "timeline",
    "time-zones",
    "scheduling",
    "meeting-planner",
    "world-clock",
    "component"
  ],
  "author": "Vladimir Pal",
  "license": "MIT"
}
